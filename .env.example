# Server port (default: 3000, Render/Docker often uses 8080)
PORT=3000

# Directory where quizkz-store.json and nightly backups are persisted
DATA_DIR=./data

# Secret used to sign HMAC authentication tokens (set a strong random string in production)
AUTH_SECRET=

# Optional Gemini API key for server-side AI features (document parsing, question generation, report analysis)
# If omitted, AI buttons remain disabled with a clear message while all other features work normally.
GEMINI_API_KEY=

# Public application URL (optional, used for share links and password reset links)
APP_URL=
